---
import type { AstroInstance } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildRegistry, type ToolMeta, wrapperFor } from "../../lib/registry";

const wrappers = import.meta.glob<AstroInstance>("../../tools/*/Tool.astro", {
	eager: true,
});

export function getStaticPaths() {
	const metas = import.meta.glob<{ default: ToolMeta }>(
		"../../tools/*/meta.ts",
		{
			eager: true,
		},
	);
	return buildRegistry(metas).map((tool) => ({
		params: { slug: tool.slug },
		props: { tool },
	}));
}

const { tool } = Astro.props;
const Tool = wrapperFor(wrappers, tool.slug);
---

<BaseLayout title={`${tool.title} — nsscode.com`} description={tool.description}>
  <a href="/" class="eyebrow hover:text-accent mb-7 inline-block transition-colors">&#8592; all tools</a>
  <h1 class="font-display mb-1.5 text-[34px] leading-[1.1] font-normal">{tool.title}</h1>
  <p class="text-ink-muted mb-8 text-[15px] leading-relaxed">{tool.description}</p>
  <Tool />
</BaseLayout>
