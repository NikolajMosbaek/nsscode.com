---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found, nsscode.com" description="There is nothing at this address." noindex>
  <section class="pt-10 pb-16 sm:pt-16">
    <p class="eyebrow mb-5">404</p>
    <h1 class="text-display max-w-[12ch] font-extrabold text-balance">Nothing at this address.</h1>
    <p class="prose-site mt-6">
      Either the link is old or the experiment was never listed to begin with. Both happen.
    </p>
    <div class="mt-8 flex flex-wrap gap-2.5">
      <a href="/" class="pill pill-active">&larr; everything</a>
      <a href="/lab/" class="pill">lab</a>
    </div>
  </section>
</BaseLayout>
