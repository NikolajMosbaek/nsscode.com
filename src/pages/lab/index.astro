---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collections } from "../../lib/collections";
import type { ExperimentMeta } from "../../lib/registry";
import { inCollection, shelfItems } from "../../lib/shelf";

const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../../experiments/*/meta.ts",
	{ eager: true },
);
const items = shelfItems(modules);
const shelves = collections.map((collection) => ({
	collection,
	items: inCollection(items, collection.id),
}));
const planned = items.filter((i) => i.planned);
const real = items.filter((i) => !i.planned);
const dates = real.map((i) => i.date).sort();
---

<BaseLayout title="Lab, nsscode.com" description="Every experiment on the site, listed with its kind and date.">
  <section class="pt-10 sm:pt-16">
    <p class="eyebrow mb-5">Lab</p>
    <h1 class="text-display max-w-[16ch] font-extrabold text-balance">The index.</h1>
    <p class="prose-site mt-6">
      {real.length} experiments, {dates[0]?.slice(0, 7)} to {dates.at(-1)?.slice(0, 7)}. A folder in the repository is all one needs. Listed ones appear here; unlisted ones only have a URL. Everything runs in the browser, nothing is tracked, nothing is stored.
    </p>
  </section>

  {
    shelves.map((shelf) => (
      <section id={shelf.collection.id} class="mt-12 scroll-mt-8 sm:mt-16" aria-labelledby={`${shelf.collection.id}-heading`}>
        <div class="border-line mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b-3 pb-3">
          <h2 id={`${shelf.collection.id}-heading`} class="text-h3 flex items-center gap-3 font-extrabold">
            <span class="border-line inline-block size-3.5 shrink-0 rounded-md border-2" style={`background: ${shelf.collection.colour}`} aria-hidden="true" />
            {shelf.collection.label}
          </h2>
          <span class="eyebrow">{shelf.collection.blurb}</span>
          <span class="eyebrow text-ink-muted ml-auto tabular-nums">{shelf.items.length}</span>
        </div>
        <ul class="m-0 grid list-none gap-0 p-0">
          {shelf.items.map((item) => (
            <li class="border-line-soft border-b-2 last:border-0">
              <a href={item.href} class="group grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-6 gap-y-1 py-4 no-underline sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto]">
                <span class="text-h3 group-hover:text-accent font-extrabold tracking-[-0.02em] transition-colors">{item.title}</span>
                <span class="text-ink-muted order-3 text-sm sm:order-none">{item.summary}</span>
                <span class="eyebrow text-ink-muted whitespace-nowrap">{item.kind} <span aria-hidden="true">·</span> {item.date}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    planned.length > 0 && (
      <section class="mt-12 sm:mt-16" aria-labelledby="planned-heading">
        <div class="border-line mb-1 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b-3 border-dashed pb-3">
          <h2 id="planned-heading" class="text-h3 font-extrabold">Planned</h2>
          <span class="eyebrow">Written down, not written yet.</span>
        </div>
        <ul class="m-0 grid list-none gap-0 p-0">
          {planned.map((item) => (
            <li class="border-line-soft grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-6 gap-y-1 border-b-2 py-4 last:border-0 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto]">
              <span class="text-h3 text-ink-muted font-extrabold tracking-[-0.02em]">{item.title}</span>
              <span class="text-ink-muted order-3 text-sm sm:order-none">{item.summary}</span>
              <span class="eyebrow text-ink-muted whitespace-nowrap">{item.kind} · soon</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
