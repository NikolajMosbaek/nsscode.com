---
import Tile from "../../components/Tile.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ExperimentMeta } from "../../lib/registry";
import { shelfItems } from "../../lib/shelf";

const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../../experiments/*/meta.ts",
	{ eager: true },
);
const items = shelfItems(modules);
const groups = [
	{
		id: "tools",
		label: "Tools",
		blurb: "Do one job.",
		items: items.filter((i) => i.kind === "tool"),
	},
	{
		id: "toys",
		label: "Toys",
		blurb: "Exist to be looked at.",
		items: items.filter((i) => i.kind === "toy"),
	},
];
---

<BaseLayout title="Lab, nsscode.com" description="Tools and toys that run in the browser, sorted by kind.">
  <section class="pt-10 sm:pt-16">
    <p class="eyebrow mb-5">Lab</p>
    <h1 class="text-display max-w-[14ch] font-extrabold text-balance">Everything on the shelf, sorted.</h1>
    <p class="prose-site mt-6">
      A folder in the repository is all an experiment needs. Listed ones show up here; unlisted ones only have a URL. Everything runs in the browser, nothing is tracked, nothing is stored.
    </p>
  </section>

  {
    groups.map((group) => (
      <section id={group.id} class="mt-14 scroll-mt-8 sm:mt-20" aria-labelledby={`${group.id}-heading`}>
        <div class="mb-6 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 id={`${group.id}-heading`} class="text-h2 font-extrabold">{group.label}</h2>
          <span class="eyebrow">{group.blurb}</span>
        </div>
        <div class="shelf grid gap-6">
          {group.items.map((item, index) => <Tile item={item} index={index + (group.id === "toys" ? 1 : 0)} />)}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .shelf {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
</style>
