---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { buildRegistry, type ExperimentMeta, listed } from "../../lib/registry";

const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../../experiments/*/meta.ts",
	{ eager: true },
);
const experiments = listed(buildRegistry(modules));
---

<BaseLayout
  title="Lab, nsscode.com"
  description="Experiments by Nikolaj Søgaard Simonsen. Small things built to learn something."
>
  <section class="pt-14 pb-12 sm:pt-24 sm:pb-16">
    <p class="eyebrow mb-6">Lab</p>
    <h1 class="text-display max-w-[16ch] font-medium text-balance">
      Small things built to learn something.
    </h1>
    <p class="prose-site mt-8">
      A folder in the repository is all an experiment needs. Listed ones show up here; unlisted ones only have a URL. Everything runs in the browser, nothing is tracked, nothing is stored.
    </p>
  </section>

  <section class="border-line-soft border-t py-12 sm:py-16" aria-label="Experiments">
    <ul class="divide-line-soft divide-y">
      {
        experiments.map((experiment) => (
          <li>
            <a href={experiment.href} class="group grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[9rem_1fr]">
              <span class="eyebrow pt-1.5">{experiment.date}</span>
              <span>
                <span class="text-h3 group-hover:text-accent font-medium transition-colors">{experiment.title}</span>
                <span class="text-small text-ink-muted mt-1.5 block max-w-[60ch]">{experiment.summary}</span>
                {experiment.tags && (
                  <span class="eyebrow mt-3 flex flex-wrap gap-x-3">
                    {experiment.tags.map((tag) => <span>{tag}</span>)}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    {experiments.length === 0 && <p class="text-small text-ink-muted">Nothing listed yet.</p>}
  </section>
</BaseLayout>
