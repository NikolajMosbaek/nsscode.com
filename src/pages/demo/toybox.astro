---
import { demoBySlug } from "../../data/demos";
import DemoLayout from "../../layouts/DemoLayout.astro";
import { demoItems } from "../../lib/demo-items";
import type { ExperimentMeta } from "../../lib/registry";

const demo = demoBySlug("toybox");
const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../../experiments/*/meta.ts",
	{ eager: true },
);
const items = demoItems(modules);
const newest = items.find((item) => item.isNew);
const built = new Date().toISOString().slice(0, 10);

const palettes = [
	{ bg: "#ffffff", fg: "#141210", muted: "#5a554f" },
	{ bg: "oklch(0.72 0.17 260)", fg: "#141210", muted: "#141210" },
	{ bg: "oklch(0.85 0.17 95)", fg: "#141210", muted: "#3a3632" },
	{ bg: "#141210", fg: "#ffffff", muted: "#d9d4cc" },
];
const rotations = [-1, 1.2, -0.6, 0.8, 0.5, -0.9, 1, -0.4];

const cells = Array.from({ length: 40 }, (_, i) => ({
	on: (i * 7 + 3) % 5 !== 0,
	dur: `${(1.2 + ((i * 13) % 7) * 0.35).toFixed(2)}s`,
	delay: `${(((i * 17) % 11) * 0.13).toFixed(2)}s`,
}));

const style = [
	"--demo-bg: oklch(0.97 0.012 90)",
	"--demo-fg: #141210",
	"--demo-accent: oklch(0.72 0.17 30)",
	"--demo-font: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif",
	"--demo-mono: 'JetBrains Mono', Menlo, monospace",
	"--demo-radius: 18px",
	"--demo-border: 3px solid #141210",
	"--demo-shadow: 6px 6px 0 #141210",
].join("; ");
---

<DemoLayout demo={demo} style={style} themeColor="#f8f5ef">
  <div class="toybox">
    <header class="top">
      <a href="/demo/toybox/" class="brand" aria-label="nsscode, home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">nsscode</span>
      </a>
      <nav aria-label="Primary" class="pills">
        <a href="#shelf" class="pill pill-active">everything</a>
        <a href="/lab/" class="pill">tools</a>
        <a href="/lab/" class="pill">toys</a>
        <a href="/demo/" class="pill">colophon</a>
      </nav>
    </header>

    <section class="hero">
      <h1>Small things that run in your browser.</h1>
      <p>A shelf of tools and toys, built one evening at a time. Nothing tracked, nothing stored, nothing to install.</p>
      {newest && <a href={newest.href} class="sticker">new this week: {newest.title}</a>}
    </section>

    <section id="shelf" class="shelf" aria-label="Experiments">
      {
        items.map((item, index) => {
          const palette = palettes[index % palettes.length];
          const Tag = item.planned ? "div" : "a";
          return (
            <Tag
              href={item.planned ? undefined : item.href}
              class:list={["tile", { planned: item.planned }]}
              style={`--tile-bg: ${palette.bg}; --tile-fg: ${palette.fg}; --tile-muted: ${palette.muted}; --r: ${rotations[index % rotations.length]}deg; animation-delay: ${(index * 0.07).toFixed(2)}s;`}
            >
              <div class="preview" aria-hidden="true">
                {item.slug === "palette" && (
                  <div class="stripes">
                    {[0.95, 0.86, 0.76, 0.65, 0.52, 0.38, 0.25].map((l) => (
                      <span style={`background: oklch(${l} 0.16 30)`} />
                    ))}
                  </div>
                )}
                {item.slug === "easing" && (
                  <div class="curve">
                    <svg viewBox="0 0 100 60" preserveAspectRatio="none"><path d="M0 58 C 20 58, 20 2, 100 2" fill="none" stroke="#141210" stroke-width="1.6" vector-effect="non-scaling-stroke" /></svg>
                    <span class="ball" />
                  </div>
                )}
                {item.slug === "plates" && (
                  <svg viewBox="0 0 180 60" fill="none" stroke="#141210" stroke-width="3" stroke-linecap="round" class="svg">
                    <line x1="8" y1="30" x2="172" y2="30" />
                    <rect x="30" y="8" width="10" height="44" rx="2" fill="oklch(0.72 0.17 30)" />
                    <rect x="42" y="14" width="8" height="32" rx="2" fill="oklch(0.72 0.17 260)" />
                    <rect x="52" y="18" width="6" height="24" rx="2" fill="oklch(0.72 0.17 150)" />
                    <rect x="140" y="8" width="10" height="44" rx="2" fill="oklch(0.72 0.17 30)" />
                    <rect x="130" y="14" width="8" height="32" rx="2" fill="oklch(0.72 0.17 260)" />
                    <rect x="122" y="18" width="6" height="24" rx="2" fill="oklch(0.72 0.17 150)" />
                  </svg>
                )}
                {item.slug === "life" && (
                  <div class="cells">
                    {cells.map((cell) => (
                      <span style={`background: ${cell.on ? "oklch(0.72 0.17 150)" : "transparent"}; animation-duration: ${cell.dur}; animation-delay: ${cell.delay};`} />
                    ))}
                  </div>
                )}
                {item.slug === "actors" && (
                  <svg viewBox="0 0 180 60" fill="none" stroke="#141210" stroke-width="3" class="svg">
                    <rect x="10" y="8" width="60" height="44" rx="6" />
                    <rect x="110" y="8" width="60" height="44" rx="6" />
                    <path d="M70 30h40" stroke-dasharray="6 6" />
                    <circle cx="40" cy="30" r="7" fill="oklch(0.72 0.17 30)" class="msg" />
                  </svg>
                )}
                {item.slug === "topskat" && (
                  <svg viewBox="0 0 180 60" fill="none" stroke="#141210" stroke-width="3" class="svg">
                    <path d="M10 52 H60 V38 H110 V22 H170" stroke-linejoin="round" />
                    <path d="M10 52 H60 V38 H110 V22 H170 V56 H10 Z" fill="oklch(0.72 0.17 30 / 0.35)" stroke="none" />
                  </svg>
                )}
                {item.slug === "timestamp" && (
                  <svg viewBox="0 0 60 60" fill="none" stroke="#141210" stroke-width="3" stroke-linecap="round" class="svg clock">
                    <circle cx="30" cy="30" r="24" />
                    <path d="M30 30V14" class="hand" />
                    <path d="M30 30l11 8" />
                  </svg>
                )}
              </div>
              <div class="tile-text">
                <span class="tile-title">
                  {item.title}
                  {item.planned && <span class="soon">soon</span>}
                </span>
                <span class="tile-summary">{item.summary}</span>
              </div>
            </Tag>
          );
        })
      }
      <div class="tile next" style="--r: -0.4deg; animation-delay: 0.6s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        next thing goes here
      </div>
    </section>

    <footer class="ticker" aria-label="Site facts">
      <div class="ticker-track">
        <span>{items.filter((i) => !i.planned).length} things running</span><span aria-hidden="true">·</span>
        <span>built {built}</span><span aria-hidden="true">·</span>
        <span>no tracking</span><span aria-hidden="true">·</span>
        <span>astro + svelte + react</span><span aria-hidden="true">·</span>
        <span>made in copenhagen</span><span aria-hidden="true">·</span>
        <a href="https://github.com/NikolajMosbaek/nsscode.com">source on github</a><span aria-hidden="true">·</span>
        <span aria-hidden="true">{items.filter((i) => !i.planned).length} things running · built {built} · no tracking · astro + svelte + react · made in copenhagen · source on github ·</span>
      </div>
    </footer>
  </div>
</DemoLayout>

<style>
  .toybox {
    --ink: #141210;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: oklch(0.97 0.012 90);
    color: var(--ink);
    font-family: 'Bricolage Grotesque', 'Helvetica Neue', Arial, sans-serif;
    overflow-x: clip;
  }
  .toybox a { color: inherit; text-decoration: none; }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 28px clamp(20px, 4vw, 56px) 0;
  }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand-mark {
    width: 40px; height: 40px;
    border: 3px solid var(--ink); border-radius: 12px;
    background: oklch(0.72 0.17 30);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .brand-name { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; }
  .pills { display: flex; flex-wrap: wrap; gap: 10px; font-family: 'JetBrains Mono', Menlo, monospace; font-size: 13px; font-weight: 500; }
  .pill {
    display: inline-flex; align-items: center; min-height: 44px;
    border: 3px solid var(--ink); border-radius: 999px; padding: 0 16px;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }
  .pill:hover { transform: translate(-2px, -2px); box-shadow: 3px 3px 0 var(--ink); }
  .pill-active { background: #fff; box-shadow: 3px 3px 0 var(--ink); }
  .hero { position: relative; padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 56px) 0; }
  .hero h1 {
    margin: 0;
    font-size: clamp(44px, 7.2vw, 104px);
    line-height: 0.92; font-weight: 800; letter-spacing: -0.045em;
    max-width: 14ch;
    font-variation-settings: 'opsz' 96;
    text-wrap: balance;
  }
  .hero p { margin: 24px 0 0; font-size: clamp(17px, 1.5vw, 22px); line-height: 1.35; max-width: 34ch; font-weight: 500; color: #3a3632; }
  .sticker {
    position: absolute; right: clamp(20px, 6vw, 88px); top: 24px;
    display: inline-flex; align-items: center; min-height: 44px;
    background: oklch(0.85 0.17 95); border: 3px solid var(--ink); border-radius: 999px;
    padding: 0 22px; font-family: 'JetBrains Mono', Menlo, monospace; font-size: 14px; font-weight: 500;
    box-shadow: 5px 5px 0 var(--ink); transform: rotate(-8deg);
    animation: wiggle 3s ease-in-out infinite;
  }
  @media (max-width: 900px) { .sticker { position: static; margin-top: 24px; transform: rotate(-2deg); } }
  .shelf {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
    padding: 48px clamp(20px, 4vw, 56px) 48px;
  }
  .toybox .tile {
    display: flex; flex-direction: column; gap: 14px;
    min-height: 250px; padding: 20px;
    border: 3px solid var(--ink); border-radius: 22px;
    background: var(--tile-bg, #fff); color: var(--tile-fg, var(--ink));
    box-shadow: 6px 6px 0 var(--ink);
    transform: rotate(var(--r, 0deg));
    animation: bob 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }
  a.tile:hover { transform: translate(-3px, -3px) rotate(var(--r, 0deg)); box-shadow: 9px 9px 0 var(--ink); }
  .tile.planned { border-style: dashed; box-shadow: none; opacity: 0.92; }
  .tile.next {
    min-height: 0; align-items: center; justify-content: center; flex-direction: row; gap: 10px;
    border-style: dashed; box-shadow: none; background: transparent; color: #5a554f;
    font-family: 'JetBrains Mono', Menlo, monospace; font-size: 13px; font-weight: 500;
  }
  .preview {
    position: relative; height: 110px; overflow: hidden;
    border: 3px solid var(--ink); border-radius: 12px; background: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .tile.planned .preview { border-style: dashed; }
  .stripes { display: flex; gap: 6px; width: 100%; height: 100%; animation: hue 12s linear infinite; }
  .stripes span { flex: 1; }
  .curve { position: absolute; inset: 0; }
  .curve svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ball {
    position: absolute; top: 50%; margin-top: -12px; width: 24px; height: 24px; border-radius: 999px;
    background: oklch(0.72 0.17 30); border: 3px solid var(--ink);
    animation: ballx 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) infinite alternate;
  }
  .svg { width: 80%; height: 70%; }
  .msg { animation: msg 2.4s ease-in-out infinite alternate; }
  .clock .hand { transform-origin: 30px 30px; animation: spin 6s linear infinite; }
  .cells {
    display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 4px;
    width: 100%; height: 100%; padding: 8px; box-sizing: border-box; background: var(--ink);
  }
  .cells span { border-radius: 3px; animation: blink 1.5s steps(1) infinite; }
  .tile-text { display: flex; flex-direction: column; gap: 4px; margin-top: auto; }
  .tile-title { display: flex; align-items: center; gap: 10px; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; }
  .soon {
    font-family: 'JetBrains Mono', Menlo, monospace; font-size: 11px; font-weight: 500; letter-spacing: 0.06em;
    border: 2px solid currentColor; border-radius: 6px; padding: 2px 6px;
  }
  .tile-summary { font-size: 14px; font-weight: 500; color: var(--tile-muted, #5a554f); }
  .ticker {
    margin-top: auto; overflow: hidden; white-space: nowrap;
    border-top: 3px solid var(--ink); background: var(--ink); color: #fff;
    font-family: 'JetBrains Mono', Menlo, monospace; font-size: 14px; font-weight: 500; padding: 14px 0;
  }
  .ticker a { text-decoration: underline; text-underline-offset: 3px; }
  .ticker-track { display: inline-flex; gap: 48px; padding-left: 48px; animation: ticker 28s linear infinite; }
  @keyframes bob { from { transform: translateY(40px) rotate(var(--r, 0deg)); opacity: 0; } to { transform: translateY(0) rotate(var(--r, 0deg)); opacity: 1; } }
  @keyframes hue { to { filter: hue-rotate(360deg); } }
  @keyframes ballx { from { left: 12px; } to { left: calc(100% - 36px); } }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.15; } }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @keyframes wiggle { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(-4deg); } }
  @keyframes msg { from { cx: 40; } to { cx: 140; } }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
