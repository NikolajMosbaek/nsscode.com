---
import AppIcon from "../components/studio/AppIcon.astro";
import DbfHistory from "../components/studio/DbfHistory.astro";
import DbfTimer from "../components/studio/DbfTimer.astro";
import MealList from "../components/studio/MealList.astro";
import MealPlan from "../components/studio/MealPlan.astro";
import Phone from "../components/studio/Phone.astro";
import { apps } from "../data/apps";
import { site } from "../data/site";
import StudioLayout from "../layouts/StudioLayout.astro";

const screens = {
	dbf: {
		front: {
			component: DbfTimer,
			label:
				"Don't Break Fast timer: a 16:8 fast with 3 hours 26 minutes remaining",
		},
		back: {
			component: DbfHistory,
			label:
				"Don't Break Fast history: Weekly Rhythm bars for each day and the last five fasts",
		},
	},
	"meal-planner": {
		front: {
			component: MealPlan,
			label:
				"Meal Planner week plan: Tuesday's kcal, protein, carbs and fat rings next to three planned meals",
		},
		back: {
			component: MealList,
			label:
				"Meal Planner shopping list grouped by aisle, two of nine items ticked",
		},
	},
} as const;

const rules = [
	["No account", "Open the app and use it. There is nothing to sign up for."],
	[
		"No tracking",
		"No analytics, no ad SDKs, no third-party code watching what you do.",
	],
	[
		"Your data stays with you",
		"It lives on your iPhone. There is no server of mine for it to go to.",
	],
	[
		"Made for iOS",
		"Swift and SwiftUI, with the widgets, Live Activities and system look you already know.",
	],
];

const since = new Date().getFullYear() - site.yearsOfIOS;
---

<StudioLayout
  title="nsscode, iPhone apps by Nikolaj Søgaard Simonsen"
  description="Focused iPhone apps from Copenhagen. No accounts, no ads, no tracking."
  image="/og-studio.png"
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="halo" aria-hidden="true"></div>
    <div class="icons">
      <a href="#dbf" aria-label="Don't Break Fast"><AppIcon slug="dbf" size={104} class="float-a" /></a>
      <a href="#meal-planner" aria-label="Meal Planner"><AppIcon slug="meal-planner" size={104} class="float-b" /></a>
    </div>
    <p class="kicker in" style="--d: 0">iPhone apps from Copenhagen</p>
    <h1 id="hero-title" class="in" style="--d: 1">Apps that keep<br /> to themselves.</h1>
    <p class="lede in" style="--d: 2">
      Small, native apps by {site.name}. Each one does a single job well, and none of them asks for an account,
      shows an ad or tracks you.
    </p>
    <nav class="jump in" style="--d: 3" aria-label="Apps">
      {
        apps.map((app) => (
          <a href={`#${app.slug}`}>
            <AppIcon slug={app.slug} size={28} />
            {app.name}
          </a>
        ))
      }
    </nav>
  </section>

  {
    apps.map((app, i) => {
      const { front, back } = screens[app.slug];
      const Front = front.component;
      const Back = back.component;
      return (
        <section id={app.slug} class:list={["app", { flip: i % 2 === 1 }]} style={`--glow: ${app.accent}`} aria-labelledby={`${app.slug}-name`}>
          <div class="copy reveal">
            <p class="index">
              {String(i + 1).padStart(2, "0")} · {app.subject}
            </p>
            <div class="title">
              <AppIcon slug={app.slug} size={76} />
              <div>
                <h2 id={`${app.slug}-name`}>
                  {app.name}
                  {app.nameNote && <span class="note">{app.nameNote}</span>}
                </h2>
                <p class="subtitle">{app.subtitle}</p>
              </div>
            </div>
            <p class="summary">{app.summary}</p>
            <ul class="features">
              {app.features.map((feature) => <li>{feature}</li>)}
            </ul>
            <div class="meta">
              {app.appStoreUrl ? (
                <a class="store" href={app.appStoreUrl}>
                  View on the App Store
                </a>
              ) : (
                <span class="status">
                  <span class="dot" aria-hidden="true" />
                  {app.status}
                </span>
              )}
              {app.links.length > 0 && (
                <ul class="links" aria-label={`${app.name} links`}>
                  {app.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          <div class="stage" data-tilt>
            <div class="glow" aria-hidden="true" />
            <div class="tilt">
              <Phone class="back" label={back.label}>
                <Back />
              </Phone>
              <Phone class="front" label={front.label}>
                <Front />
              </Phone>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="rules" aria-labelledby="rules-title">
    <h2 id="rules-title" class="reveal">Same rules for every app.</h2>
    <ol>
      {
        rules.map(([name, text], i) => (
          <li class="reveal">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="maker reveal" aria-label="About">
    <p>
      nsscode is {site.name}, a senior iOS engineer in {site.location.split(",")[0]} who has been building for
      iOS since {since}. The apps are made in the evenings, one at a time, and kept small on purpose.
    </p>
  </section>
</StudioLayout>

<script>
  /* Keeps the timer on the first phone running, so the page is alive without moving anything big. */
  const timer = document.querySelector<HTMLElement>("[data-fast]");
  if (timer) {
    const total = Number(timer.dataset.fast);
    const ring = timer.querySelector<SVGCircleElement>("[data-ring]");
    const remaining = timer.querySelector<HTMLElement>("[data-remaining]");
    const elapsedLabel = timer.querySelector<HTMLElement>("[data-elapsed-label]");
    const circumference = 2 * Math.PI * 141;
    const started = Date.now() - Number(timer.dataset.elapsed) * 1000;
    const pad = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      const elapsed = Math.floor((Date.now() - started) / 1000) % total;
      const left = total - elapsed;
      if (remaining) {
        remaining.textContent = `${Math.floor(left / 3600)}:${pad(Math.floor(left / 60) % 60)}:${pad(left % 60)}`;
      }
      if (elapsedLabel) {
        elapsedLabel.textContent = `${Math.floor(elapsed / 3600)}:${pad(Math.floor(elapsed / 60) % 60)}`;
      }
      ring?.setAttribute("stroke-dasharray", `${((elapsed / total) * circumference).toFixed(1)} ${circumference.toFixed(1)}`);
    };
    tick();
    setInterval(tick, 1000);
  }

  /*
   * Phones lean toward the pointer. Only for a mouse or trackpad, and only
   * when motion is welcome. The page's CSS reads the four variables.
   */
  const lean = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
  if (lean.matches) {
    for (const stage of document.querySelectorAll<HTMLElement>("[data-tilt]")) {
      let frame = 0;
      stage.addEventListener("pointermove", (event) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = stage.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width - 0.5;
          const y = (event.clientY - box.top) / box.height - 0.5;
          stage.style.setProperty("--ry", `${(x * 8).toFixed(2)}deg`);
          stage.style.setProperty("--rx", `${(-y * 8).toFixed(2)}deg`);
          stage.style.setProperty("--px", `${((x + 0.5) * 100).toFixed(1)}%`);
          stage.style.setProperty("--py", `${((y + 0.5) * 100).toFixed(1)}%`);
        });
      });
      stage.addEventListener("pointerleave", () => {
        cancelAnimationFrame(frame);
        for (const name of ["--rx", "--ry", "--px", "--py"]) stage.style.removeProperty(name);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(140px, 22vh, 220px) 20px clamp(96px, 16vh, 160px);
    isolation: isolate;
    overflow-x: clip;
    perspective: 900px;
  }

  .halo {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 0;
    width: min(1100px, 140vw);
    height: 720px;
    transform: translateX(-50%);
    background:
      radial-gradient(closest-side at 38% 42%, rgb(54 198 184 / 0.22), transparent),
      radial-gradient(closest-side at 64% 46%, rgb(130 198 159 / 0.16), transparent),
      radial-gradient(closest-side at 52% 30%, rgb(233 155 42 / 0.08), transparent);
    filter: blur(20px);
  }

  .icons {
    display: flex;
    gap: 22px;
    margin-bottom: 44px;
  }

  .kicker {
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 0.8rem + 8.4vw, 8.25rem);
    font-weight: 620;
    line-height: 0.92;
    letter-spacing: -0.045em;
    background: linear-gradient(180deg, #ffffff 30%, #a9aba7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.08em;
  }

  .lede {
    max-width: 34rem;
    margin: 30px 0 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px 8px 8px;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    background: rgb(255 255 255 / 0.04);
    font-size: 15px;
    font-weight: 500;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .jump a:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.18);
  }

  .jump :global(.app-icon) {
    border-radius: 50%;
  }

  .app {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(64px, 12vh, 140px) clamp(20px, 5vw, 56px);
    overflow-x: clip;
  }

  .app.flip .copy {
    order: 2;
  }

  .index {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  h2 {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem);
    font-weight: 620;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .note {
    display: inline-block;
    margin-left: 12px;
    padding: 3px 9px;
    border: 1px solid var(--line-soft);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    vertical-align: middle;
    color: var(--ink-muted);
  }

  .subtitle {
    margin: 8px 0 0;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    color: var(--glow);
  }

  .summary {
    max-width: 32rem;
    margin: 32px 0 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .features {
    max-width: 32rem;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-soft);
  }

  .features li {
    padding: 13px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15px;
    color: var(--ink-soft);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }

  .status,
  .store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-soft);
    background: rgb(255 255 255 / 0.04);
    font-size: 14px;
    font-weight: 500;
  }

  .store {
    background: var(--ink);
    color: var(--ground);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 12px var(--glow);
  }

  .links {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  /* Two underlines: a faint one always, and a bright one that draws in from the left. */
  .links a {
    padding-bottom: 3px;
    color: var(--ink-muted);
    background-image: linear-gradient(currentColor, currentColor), linear-gradient(rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.2));
    background-size:
      0% 1px,
      100% 1px;
    background-position:
      0 100%,
      0 100%;
    background-repeat: no-repeat;
    transition:
      color var(--duration-base) var(--ease-out),
      background-size var(--duration-slow) var(--ease-out);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--ink);
    background-size:
      100% 1px,
      100% 1px;
  }

  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    isolation: isolate;
    padding: 20px 0 60px;
    perspective: 1600px;
    /* Phones on the right turn toward the copy on the left, and back again when flipped. */
    --turn: 1;
  }

  .app.flip .stage {
    --turn: -1;
  }

  .glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    width: 130%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in oklab, var(--glow) 26%, transparent), transparent 72%);
    filter: blur(10px);
  }

  .tilt {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    /* Its own perspective, not preserve-3d: each phone stays flat in its own plane and the back one never cuts through the front. */
    perspective: 1600px;
    transition: transform 700ms var(--ease-out);
  }

  .stage :global(.back) {
    margin-top: 60px;
    margin-right: -110px;
    opacity: 0.72;
    filter: saturate(0.9) brightness(0.85);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      filter var(--duration-slow) var(--ease-out),
      translate var(--duration-slow) var(--ease-out);
  }

  .stage :global(.front) {
    transition: translate var(--duration-slow) var(--ease-out);
  }

  /* Hovering the pair fans it open a little. translate composes with the scroll animation's transform. */
  @media (hover: hover) and (pointer: fine) {
    .stage:hover :global(.back) {
      opacity: 0.95;
      filter: none;
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .stage:hover :global(.back) {
      translate: -24px 6px;
    }

    .stage:hover :global(.front) {
      translate: 8px -4px;
    }
  }

  .icons a {
    display: block;
    border-radius: 24px;
  }

  .icons :global(.app-icon) {
    transition:
      translate var(--duration-slow) var(--ease-out),
      box-shadow var(--duration-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .icons a:hover :global(.app-icon),
    .icons a:focus-visible :global(.app-icon) {
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.18) inset,
        0 22px 50px -14px var(--icon-glow);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .icons a:hover :global(.app-icon),
    .icons a:focus-visible :global(.app-icon) {
      translate: 0 -3px;
    }
  }

  .stage :global(.front) {
    position: relative;
  }

  .rules {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(80px, 14vh, 160px) clamp(20px, 5vw, 56px) clamp(56px, 10vh, 120px);
  }

  .rules h2 {
    max-width: 20ch;
  }

  .rules ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px 32px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .rules li {
    padding-top: 22px;
    border-top: 1px solid rgb(255 255 255 / 0.22);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-muted);
  }

  h3 {
    margin: 18px 0 10px;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .rules p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .maker {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 56px) clamp(80px, 14vh, 140px);
  }

  .maker p {
    max-width: 40rem;
    margin: 0;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }

    .app.flip .copy {
      order: 0;
    }

    .rules ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .icons {
      gap: 16px;
      margin-bottom: 36px;
    }

    .icons :global(.app-icon) {
      --size: 80px !important;
    }

    .title {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .stage :global(.back) {
      margin-top: 44px;
      margin-right: -96px;
    }

    .rules ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /*
   * Motion. Everything below is extra: with reduced motion, or in a browser
   * without scroll-driven animations, the page is complete and still.
   */
  @media (prefers-reduced-motion: no-preference) {
    .in {
      animation: enter 1.1s var(--ease-out) both;
      animation-delay: calc(120ms + var(--d) * 110ms);
    }

    .icons :global(.float-a) {
      animation:
        enter 1.1s var(--ease-out) both,
        float 7s ease-in-out 1.1s infinite alternate;
    }

    .icons :global(.float-b) {
      animation:
        enter 1.1s var(--ease-out) 90ms both,
        float 7s ease-in-out 2.4s infinite alternate-reverse;
    }

    .halo {
      animation: breathe 12s ease-in-out infinite alternate;
    }

    @supports (animation-timeline: view()) {
      .reveal {
        animation-name: reveal;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      /* The phones turn in as they arrive, settle near the middle of the screen, and tip away as they leave. */
      .stage :global(.front) {
        animation-name: turn-front;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .stage :global(.back) {
        animation-name: turn-back;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }

      .icons {
        animation-name: tip;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(24px);
      filter: blur(6px);
    }
  }

  @keyframes float {
    to {
      transform: translateY(-10px);
    }
  }

  @keyframes breathe {
    to {
      opacity: 0.7;
      transform: translateX(-50%) scale(1.06);
    }
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @keyframes turn-front {
    from {
      transform: translateY(70px) rotateX(12deg) rotateY(calc(var(--turn) * -18deg));
    }
    50% {
      transform: translateY(0) rotateX(2deg) rotateY(calc(var(--turn) * -5deg));
    }
    to {
      transform: translateY(-40px) rotateX(-8deg) rotateY(calc(var(--turn) * 6deg));
    }
  }

  @keyframes turn-back {
    from {
      transform: translateY(-20px) rotateX(10deg) rotateY(calc(var(--turn) * -26deg));
    }
    50% {
      transform: translateY(10px) rotateX(2deg) rotateY(calc(var(--turn) * -12deg));
    }
    to {
      transform: translateY(50px) rotateX(-6deg) rotateY(calc(var(--turn) * -2deg));
    }
  }

  @keyframes tip {
    to {
      opacity: 0.3;
      transform: translateY(-24px) rotateX(38deg) scale(0.92);
    }
  }
</style>
