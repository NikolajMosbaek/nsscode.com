---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildRegistry, type ToolMeta } from "../lib/registry";

const modules = import.meta.glob<{ default: ToolMeta }>("../tools/*/meta.ts", {
	eager: true,
});
const tools = buildRegistry(modules);
---

<BaseLayout title="nsscode.com">
  <h1 class="font-display mb-2.5 text-[46px] leading-[1.05] font-normal">Tools</h1>
  <p class="text-ink-muted mb-9 max-w-[46ch] text-base leading-relaxed">
    Small things I got tired of looking up.
  </p>

  <ul class="grid gap-4 sm:grid-cols-2">
    {
      tools.map((tool) => (
        <li>
          <a
            href={`/tools/${tool.slug}/`}
            class="bg-surface border-line shadow-card hover:border-accent group flex h-full flex-col rounded-2xl border p-6 transition-colors"
          >
            <div class="mb-2.5 flex items-center gap-2.5">
              <span class="text-base font-semibold">{tool.title}</span>
              {tool.tags[0] && (
                <span class="bg-chip text-accent-deep font-mono text-[10px] tracking-[0.08em] uppercase rounded px-1.5 py-0.5">
                  {tool.tags[0]}
                </span>
              )}
            </div>
            <span class="text-ink-muted text-sm leading-relaxed">{tool.description}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {tools.length === 0 && <p class="text-ink-faint">No tools yet.</p>}

  <a
    href="/recipes/"
    class="bg-surface border-line shadow-card hover:border-accent group mt-9 flex items-center justify-between gap-4 rounded-2xl border p-6 transition-colors"
  >
    <span class="flex flex-col gap-1.5">
      <span class="text-base font-semibold">Recipes</span>
      <span class="text-ink-muted text-sm leading-relaxed">
        Things worth cooking twice — scaled to the table, with macros and a rating.
      </span>
    </span>
    <span class="text-ink-faint group-hover:text-accent shrink-0 text-lg transition-colors" aria-hidden="true">&#8594;</span>
  </a>
</BaseLayout>
