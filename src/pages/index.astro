---
import Tile from "../components/Tile.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { collections } from "../lib/collections";
import type { ExperimentMeta } from "../lib/registry";
import { inCollection, shelfItems } from "../lib/shelf";

const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../experiments/*/meta.ts",
	{ eager: true },
);
const items = shelfItems(modules);
const feature = items.find((item) => item.isNew) ?? items[0];
const shelves = collections
	.map((collection) => ({
		collection,
		items: inCollection(items, collection.id),
	}))
	.filter((shelf) => shelf.items.length > 0);
const count = items.filter((i) => !i.planned).length;
---

<BaseLayout title="nsscode.com, small things that run in your browser">
  <section class="pt-10 sm:pt-16">
    <h1 class="text-display max-w-[14ch] font-extrabold text-balance">Small things that run in your browser.</h1>
    <p class="text-lede text-ink-soft mt-6 max-w-[38ch] font-medium text-pretty">
      {count} tools and toys, built one evening at a time. Nothing tracked, nothing stored, nothing to install.
    </p>
  </section>

  {
    feature && (
      <section class="mt-10 sm:mt-14" aria-labelledby="feature-heading">
        <p id="feature-heading" class="eyebrow mb-4">Newest</p>
        <Tile item={feature} size="feature" index={0} />
      </section>
    )
  }

  {
    shelves.map((shelf, shelfIndex) => (
      <section id={shelf.collection.id} class="mt-14 scroll-mt-8 sm:mt-20" aria-labelledby={`${shelf.collection.id}-heading`}>
        <div class="border-line mb-6 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b-3 pb-3">
          <h2 id={`${shelf.collection.id}-heading`} class="text-h2 flex items-center gap-3 font-extrabold">
            <span class="border-line inline-block size-4 shrink-0 rounded-md border-3" style={`background: ${shelf.collection.colour}`} aria-hidden="true" />
            {shelf.collection.label}
          </h2>
          <span class="eyebrow">{shelf.collection.blurb}</span>
        </div>
        <div class="shelf grid gap-5">
          {shelf.items.map((item, index) => (
            <Tile item={item} index={shelfIndex * 3 + index} />
          ))}
        </div>
      </section>
    ))
  }

  <section class="mt-14 sm:mt-20">
    <a href="/lab/" class="card-dashed text-ink-muted hover:text-ink flex items-center justify-center gap-3 px-6 py-8 font-mono text-sm font-medium no-underline transition-colors">
      Everything at once, including what is planned
      <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>

<style>
  /*
   * auto-fit, not auto-fill: a category with one or two experiments gets
   * wide columns instead of a mostly empty row, and the tile itself goes
   * horizontal at that width.
   */
  .shelf {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
</style>
