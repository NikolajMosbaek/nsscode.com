---
/*
 * One item on the shelf. Two sizes: `feature` is the single loud thing at
 * the top of the home page, `compact` is a row member. Colour comes from
 * the collection, never from the index, so it means something and does
 * not change when a new experiment lands. Planned items are not links.
 *
 * The layout follows the width the tile is given, not the viewport: a
 * category with one or two experiments gets wide columns, and a wide
 * tile puts its drawing beside the text instead of above it. That is a
 * container query, so it has to look at an inner element; a container
 * cannot style itself.
 */
import { collectionOf } from "../lib/collections";
import type { ShelfItem } from "../lib/shelf";
import TilePreview from "./TilePreview.astro";

interface Props {
	item: ShelfItem;
	size?: "feature" | "compact";
	index?: number;
}

const { item, size = "compact", index = 0 } = Astro.props;
const collection = collectionOf(item.collection);
const Tag = item.planned ? "div" : "a";
---

<Tag
  href={item.planned ? undefined : item.href}
  class:list={["tile bob-in", `tile-${size}`, { planned: item.planned }]}
  style={`--i: ${index}; --accent-colour: ${collection.colour};`}
>
  <div class="inner">
    <div class="preview-wrap">
      <TilePreview slug={item.slug} title={item.title} />
    </div>
    <div class="text">
      <span class="title">
        {item.title}
        {item.planned && <span class="tag">soon</span>}
        {item.isNew && <span class="tag tag-new">new</span>}
      </span>
      <span class="summary">{item.summary}</span>
      {size === "feature" && <span class="cue">Open it →</span>}
    </div>
  </div>
</Tag>

<style>
  .tile {
    container-type: inline-size;
    display: block;
    height: 100%;
    padding: 18px;
    border: 3px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 5px 5px 0 var(--line);
    text-decoration: none;
    transition:
      translate var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }
  a.tile:hover {
    translate: -3px -3px;
    box-shadow: 8px 8px 0 var(--line);
  }
  .tile.planned {
    border-style: dashed;
    box-shadow: none;
    opacity: 0.75;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  /* The collection colour, as a band above the drawing. */
  .preview-wrap {
    position: relative;
    border-radius: 14px;
  }
  .preview-wrap::before {
    content: "";
    position: absolute;
    inset: -3px -3px auto;
    height: 8px;
    border: 3px solid var(--line);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: var(--accent-colour);
    z-index: 1;
  }
  .preview-wrap :global(.preview) {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .summary {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-muted);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    border: 2px solid currentColor;
    border-radius: 6px;
    padding: 2px 6px;
  }
  .tag-new {
    background: var(--yellow);
    color: var(--accent-ink);
    border-color: var(--accent-ink);
  }

  /* Wide enough for two columns of reading: give it two. */
  @container (min-width: 430px) {
    .tile-compact .inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 24px;
    }
    .tile-compact .preview-wrap :global(.preview) {
      height: 150px;
    }
    .tile-compact .title {
      font-size: 25px;
    }
    .tile-compact .summary {
      font-size: 14.5px;
    }
  }

  /* The one loud thing. */
  .tile-feature {
    padding: 22px;
    border-radius: 26px;
    box-shadow: 8px 8px 0 var(--line);
  }
  .tile-feature .inner {
    gap: 22px;
  }
  .tile-feature .title {
    font-size: clamp(30px, 4vw, 44px);
  }
  .tile-feature .summary {
    font-size: 16px;
    max-width: 52ch;
    color: var(--ink-soft);
  }
  .tile-feature .cue {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }
  .tile-feature .preview-wrap :global(.preview) {
    height: 210px;
  }
  a.tile-feature:hover {
    translate: -4px -4px;
    box-shadow: 12px 12px 0 var(--line);
  }
  @container (min-width: 760px) {
    .tile-feature .inner {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: 32px;
    }
    .tile-feature .preview-wrap :global(.preview) {
      height: 260px;
    }
  }
</style>
