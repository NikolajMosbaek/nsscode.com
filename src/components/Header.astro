---
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const nav = [
	{ label: "everything", href: "/", current: path === "/" },
	{ label: "tools", href: "/lab/#tools", current: false },
	{ label: "toys", href: "/lab/#toys", current: false },
	{
		label: "colophon",
		href: "/colophon/",
		current: path.startsWith("/colophon"),
	},
];
---

<header class="site-header">
  <div class="mx-auto flex w-full max-w-[90rem] flex-wrap items-center justify-between gap-4 px-5 pt-7 sm:px-10 lg:px-14">
    <a href="/" class="flex items-center gap-3.5" aria-label="nsscode, home">
      <span class="bg-accent border-line inline-block size-10 rounded-xl border-3 shadow-[4px_4px_0_var(--line)]" aria-hidden="true"></span>
      <span class="text-[26px] font-extrabold tracking-[-0.03em]">nsscode</span>
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center gap-2.5">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={item.current ? "page" : undefined} class:list={["pill", { "pill-active": item.current }]}>
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    view-transition-name: site-header;
  }
</style>
