---
/*
 * The "about" button on every demo home page. Opens a native dialog with
 * the case for and against that direction, and links to the other three.
 * Styled through CSS variables the page sets on <main>: --demo-bg,
 * --demo-fg, --demo-accent, --demo-font, --demo-mono, --demo-radius,
 * --demo-border.
 */
import type { Demo } from "../data/demos";
import { demos } from "../data/demos";

interface Props {
	demo: Demo;
}

const { demo } = Astro.props;
const others = demos.filter((d) => d.slug !== demo.slug);
---

<button type="button" data-about-open class="demo-about-button" aria-haspopup="dialog" aria-controls="demo-about">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 11v6M12 7.5v.01" />
  </svg>
  <span>About this design</span>
</button>

<dialog id="demo-about" class="demo-about" aria-labelledby="demo-about-title">
  <div class="demo-about-inner">
    <p class="demo-about-eyebrow">Direction {demo.letter} · demo</p>
    <h2 id="demo-about-title" class="demo-about-title">{demo.name}</h2>
    <p class="demo-about-tagline">{demo.tagline}</p>

    <div class="demo-about-columns">
      <section aria-labelledby="demo-about-for">
        <h3 id="demo-about-for" class="demo-about-eyebrow">For</h3>
        <ul class="demo-about-list">
          {demo.pros.map((pro) => <li>{pro}</li>)}
        </ul>
      </section>
      <section aria-labelledby="demo-about-against">
        <h3 id="demo-about-against" class="demo-about-eyebrow">Against</h3>
        <ul class="demo-about-list">
          {demo.cons.map((con) => <li>{con}</li>)}
        </ul>
      </section>
    </div>

    <p class="demo-about-note">
      A demo kept for reference. Toybox won and is the site. The experiments that link are real; the ones marked soon are proposals from the plan.
    </p>

    <nav aria-label="Other directions" class="demo-about-nav">
      {others.map((other) => (
        <a href={`/demo/${other.slug}/`}>{other.letter} · {other.name}</a>
      ))}
      <a href="/">A · Toybox, the site</a>
    </nav>

    <form method="dialog" class="demo-about-close">
      <button type="submit">Close</button>
    </form>
  </div>
</dialog>

<style>
  .demo-about-button {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: var(--demo-border, 2px solid currentColor);
    border-radius: var(--demo-radius, 999px);
    background: var(--demo-fg, #111);
    color: var(--demo-bg, #fff);
    font-family: var(--demo-mono, ui-monospace, monospace);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: var(--demo-shadow, 0 6px 20px rgb(0 0 0 / 0.25));
    transition: transform 140ms ease;
  }
  .demo-about-button:hover {
    transform: translateY(-2px);
  }
  .demo-about {
    width: min(720px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    padding: 0;
    border: var(--demo-border, 2px solid currentColor);
    border-radius: var(--demo-radius, 16px);
    background: var(--demo-bg, #fff);
    color: var(--demo-fg, #111);
    font-family: var(--demo-font, system-ui, sans-serif);
    box-shadow: var(--demo-shadow, 0 20px 60px rgb(0 0 0 / 0.35));
  }
  .demo-about::backdrop {
    background: rgb(0 0 0 / 0.55);
  }
  .demo-about-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
  }
  .demo-about-eyebrow {
    margin: 0;
    font-family: var(--demo-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .demo-about-title {
    margin: 0;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .demo-about-tagline {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    max-width: 58ch;
  }
  .demo-about-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-top: 6px;
    border-top: 1px solid color-mix(in oklab, currentColor 25%, transparent);
  }
  @media (max-width: 600px) {
    .demo-about-columns {
      grid-template-columns: 1fr;
    }
  }
  .demo-about-list {
    margin: 10px 0 0 0;
    padding: 0 0 0 1.1em;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.5;
  }
  .demo-about-note {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.8;
  }
  .demo-about-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: var(--demo-mono, ui-monospace, monospace);
    font-size: 13px;
  }
  .demo-about-nav a {
    color: inherit;
    text-decoration: none;
    border: 1px solid currentColor;
    border-radius: var(--demo-radius, 999px);
    padding: 8px 12px;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
  }
  .demo-about-nav a:hover {
    background: var(--demo-fg, #111);
    color: var(--demo-bg, #fff);
  }
  .demo-about-close {
    margin: 0;
    display: flex;
    justify-content: flex-end;
  }
  .demo-about-close button {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--demo-radius, 999px);
    background: var(--demo-fg, #111);
    color: var(--demo-bg, #fff);
    font-family: var(--demo-mono, ui-monospace, monospace);
    font-size: 13px;
    cursor: pointer;
  }
</style>

<script>
  const dialog = document.getElementById("demo-about") as HTMLDialogElement | null;
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-about-open]")) {
    button.addEventListener("click", () => dialog?.showModal());
  }
</script>
