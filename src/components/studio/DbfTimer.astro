---
/*
 * Don't Break Fast, timer screen, dark. Numbers follow the app's design
 * file: a 16:8 fast started yesterday at 20:00, drawn on yesterday's and
 * today's 24-hour rails. A small script on the page keeps the clock and
 * the rails running.
 */
const fastSeconds = 16 * 3600;
const elapsed = 12 * 3600 + 34 * 60;
const percent = (hours: number) => `${((hours / 24) * 100).toFixed(2)}%`;
const now = 8 + 34 / 60;
---

<div class="timer" data-fast={fastSeconds} data-elapsed={elapsed}>
  <div class="top">
    <span class="glass plan">16:8 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="rgba(235,235,245,0.6)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg></span>
    <span class="glass tools">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="3.5" /><path d="M8.5 4.5v15" /><path d="M11.5 9.5h5.5" /><path d="M11.5 14.5h3.5" /></svg>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /><circle cx="9" cy="6" r="2.2" fill="#fff" /><circle cx="15.5" cy="12" r="2.2" fill="#fff" /><circle cx="7" cy="18" r="2.2" fill="#fff" /></svg>
    </span>
  </div>

  <div class="hero">
    <span class="caption">Remaining</span>
    <span class="big numeral" data-remaining>3:26:00</span>
    <span class="small"><span data-elapsed-label>12:34</span> elapsed of 16 h</span>
  </div>

  <div class="strip">
    <div class="hours"><span>00</span><span>06</span><span>12</span><span>18</span><span>24</span></div>
    <span class="day">Yesterday</span>
    <div class="rail">
      <i style="left: 25%"></i><i style="left: 50%"></i><i style="left: 75%"></i>
      <b data-bar="yesterday" style={`left: ${percent(20)}; width: ${percent(4)}`}></b>
      <s data-left="yesterday" style="display: none"></s>
      <em data-now="yesterday" style="display: none"></em>
    </div>
    <span class="day">Today</span>
    <div class="rail">
      <i style="left: 25%"></i><i style="left: 50%"></i><i style="left: 75%"></i>
      <b data-bar="today" style={`left: 0%; width: ${percent(now)}`}></b>
      <s data-left="today" style={`left: ${percent(now)}; width: ${percent(12 - now)}`}></s>
      <u style="left: 50%"></u>
      <em data-now="today" style={`left: ${percent(now)}`}></em>
    </div>
    <div class="foot"><span style="left: 50%">Goal 12:00</span></div>
  </div>

  <div class="started">Started <span class="accent">yesterday, 20:00</span></div>

  <span class="end">End fast</span>
</div>

<style>
  .timer {
    position: absolute;
    inset: 0;
    background: #000;
  }

  .top {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 62px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .glass {
    display: flex;
    align-items: center;
    height: 44px;
    border-radius: 22px;
    background: rgb(44 44 48 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
  }

  .plan {
    gap: 6px;
    padding: 0 14px 0 16px;
    font-size: 17px;
    font-weight: 600;
  }

  .tools {
    gap: 24px;
    padding: 0 16px;
  }

  .hero {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 130px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .caption {
    font-size: 15px;
    font-weight: 500;
    color: rgb(235 235 245 / 0.6);
  }

  .big {
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .small {
    font-size: 17px;
    color: rgb(235 235 245 / 0.6);
    margin-top: 2px;
  }

  .strip {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 300px;
    padding: 16px 18px 14px;
    border-radius: 22px;
    background: #1c1c1e;
  }

  .hours {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 11px;
    color: rgb(235 235 245 / 0.3);
  }

  .day {
    display: block;
    margin: 10px 0 6px;
    font-size: 15px;
    font-weight: 500;
    color: rgb(235 235 245 / 0.6);
  }

  /* One 24-hour day: b is fasted time, s the outline still to go, u the goal, em now. */
  .rail {
    position: relative;
    height: 34px;
    border-radius: 8px;
    background: rgb(235 235 245 / 0.12);
  }

  .rail i {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgb(84 84 88 / 0.65);
  }

  .rail b,
  .rail s {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 8px;
  }

  .rail b {
    background: #8e99e8;
  }

  .rail s {
    box-shadow: inset 0 0 0 2px #8e99e8;
  }

  .rail u {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 2px;
    margin-left: -1px;
    background: rgb(255 255 255 / 0.35);
  }

  .rail em {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: #1c1c1e;
    box-shadow: 0 0 0 3px #8e99e8;
  }

  .foot {
    position: relative;
    height: 18px;
    margin-top: 8px;
    font-size: 13px;
    color: rgb(235 235 245 / 0.6);
  }

  .foot span {
    position: absolute;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .started {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 556px;
    font-size: 17px;
    color: rgb(235 235 245 / 0.6);
  }

  .accent {
    color: #8e99e8;
    font-weight: 500;
  }

  .end {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 50px;
    height: 54px;
    border-radius: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 600;
    background: color-mix(in oklab, #8e99e8 72%, black);
    border: 1px solid rgb(255 255 255 / 0.45);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.55);
  }
</style>
