---
/*
 * Don't Break Fast, history screen with Weekly Rhythm, dark. Rows follow
 * the app's design file. Bar positions are percent of a 24 hour day.
 */
const week: [string, [number, number][]][] = [
	["Mon", [[83, 17]]],
	[
		"Tue",
		[
			[0, 50],
			[82, 18],
		],
	],
	[
		"Wed",
		[
			[0, 50],
			[84, 16],
		],
	],
	[
		"Thu",
		[
			[0, 51],
			[80, 20],
		],
	],
	[
		"Fri",
		[
			[0, 48],
			[88, 12],
		],
	],
	[
		"Sat",
		[
			[0, 44],
			[81, 19],
		],
	],
	[
		"Sun",
		[
			[0, 50],
			[84, 9],
		],
	],
];

const fasts = [
	["Sunday 6 Sep", "20:00 to 12:04", "16 h 4 min", true],
	["Saturday 5 Sep", "19:30 to 11:45", "16 h 15 min", true],
	["Friday 4 Sep", "21:10 to 10:20", "13 h 10 min", false],
	["Thursday 3 Sep", "20:00 to 12:30", "16 h 30 min", true],
	["Wednesday 2 Sep", "20:15 to 14:20", "18 h 5 min", true],
] as const;
---

<div class="history">
  <span class="back"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg></span>
  <span class="title">History</span>

  <div class="stack">
    <div class="group">
      <span class="caption">Weekly Rhythm</span>
      <div class="panel rhythm">
        <div class="row axis"><span></span><span class="hours"><span>00</span><span>12</span><span>24</span></span></div>
        {
          week.map(([day, bars]) => (
            <div class="row">
              <span class="day">{day}</span>
              <span class="track">
                <i style="left:25%" />
                <i style="left:50%" />
                <i style="left:75%" />
                {bars.map(([left, width]) => (
                  <b style={`left:${left}%;width:${width}%`} />
                ))}
              </span>
            </div>
          ))
        }
        <span class="foot">7 fasts · 16 h 4 min average</span>
      </div>
    </div>

    <div class="group">
      <span class="caption">September 2026</span>
      <div class="panel">
        {
          fasts.map(([day, span, length, met]) => (
            <div class="fast">
              <span class="col">
                <span class="name">{day}</span>
                <span class="sub">{span}</span>
              </span>
              <span class="col end">
                <span class="length">{length}</span>
                <span class:list={["goal", { met }]}>
                  {met && (
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                  )}
                  Goal 16 h
                </span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .history {
    position: absolute;
    inset: 0;
    background: #000;
  }

  .back {
    position: absolute;
    left: 20px;
    top: 62px;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(44 44 48 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.14);
  }

  .title {
    position: absolute;
    left: 20px;
    top: 122px;
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .stack {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 180px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .caption {
    padding: 0 16px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(235 235 245 / 0.6);
  }

  .panel {
    background: #1c1c1e;
    border-radius: 20px;
    overflow: hidden;
  }

  .rhythm {
    padding: 13px 16px 14px;
  }

  .row {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: center;
    gap: 8px;
    height: 23px;
  }

  .axis {
    height: auto;
    align-items: end;
    margin-bottom: 2px;
  }

  .hours {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: rgb(235 235 245 / 0.3);
  }

  .day {
    font-size: 13px;
    font-weight: 600;
    color: rgb(235 235 245 / 0.6);
  }

  .track {
    position: relative;
    height: 12px;
    border-radius: 6px;
    background: rgb(235 235 245 / 0.12);
  }

  .track i {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 1px;
    background: rgb(84 84 88 / 0.65);
  }

  .track b {
    position: absolute;
    top: 3px;
    height: 6px;
    border-radius: 3px;
    background: #36c6b8;
  }

  .foot {
    display: block;
    font-size: 13px;
    color: rgb(235 235 245 / 0.6);
    margin-top: 9px;
  }

  .fast {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 62px;
    padding: 0 16px;
    border-bottom: 1px solid rgb(84 84 88 / 0.65);
  }

  .fast:last-child {
    border-bottom: 0;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .end {
    align-items: flex-end;
  }

  .name {
    font-size: 17px;
    font-weight: 600;
  }

  .sub {
    font-size: 14px;
    color: rgb(235 235 245 / 0.6);
  }

  .length {
    font-size: 17px;
    font-weight: 500;
  }

  .goal {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    color: rgb(235 235 245 / 0.6);
  }

  .goal.met {
    color: #36c6b8;
  }
</style>
