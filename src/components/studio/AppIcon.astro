---
/*
 * The two app icons, redrawn from the apps' own icon sources so the page
 * needs no image files. The squircle is a CSS mask shape, close to the
 * iOS corner.
 */
interface Props {
	slug: "dbf" | "meal-planner";
	size?: number;
	class?: string;
}

const { slug, size = 96, class: className } = Astro.props;
const clip = `dbf-now-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={["app-icon", slug, className]} style={`--size: ${size}px`} aria-hidden="true">
  {
    slug === "dbf" ? (
      <svg viewBox="0 0 100 100" class="dbf">
        <defs>
        <clipPath id={clip}>
        <path clip-rule="evenodd" d="M0 0h100v100H0z M37.33 76.10m-1.97 0a1.97 1.97 0 1 0 3.94 0a1.97 1.97 0 1 0 -3.94 0z" />
        </clipPath>
        </defs>
        <g clip-path={`url(#${clip})`}>
        <rect x="18.00" y="21.00" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="21.00" width="24.00" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="63.33" y="21.00" width="18.67" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="18.00" y="29.70" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="29.70" width="24.00" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="63.33" y="29.70" width="18.67" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="18.00" y="38.40" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="38.40" width="24.00" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="64.00" y="38.40" width="18.00" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="18.00" y="47.10" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="47.10" width="24.67" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="63.33" y="47.10" width="18.67" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="18.00" y="55.80" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="55.80" width="25.33" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="64.67" y="55.80" width="17.33" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="40.43" y="55.80" width="6.90" height="5.8" rx="2.9" fill="#e99b2a" />
        <rect x="18.00" y="64.50" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="64.50" width="25.33" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="63.33" y="64.50" width="18.67" height="5.8" rx="2.9" fill="#5b5bd6" />
        <rect x="18.00" y="73.20" width="64.00" height="5.8" rx="2.9" fill="#8E8E93" fill-opacity="0.2" />
        <rect x="18.00" y="73.20" width="19.33" height="5.8" rx="2.9" fill="#5b5bd6" />
        </g>
        <circle cx="37.33" cy="76.10" r="3.07" fill="none" stroke="#e99b2a" stroke-width="2.20" />
      </svg>
    ) : (
      <svg viewBox="0 0 1024 1024" class="meal">
        <circle cx="512" cy="512" r="256" fill="none" stroke="#E3EBE4" stroke-opacity="0.25" stroke-width="120" />
        <circle
          cx="512"
          cy="512"
          r="256"
          fill="none"
          stroke="#E3EBE4"
          stroke-width="120"
          stroke-linecap="round"
          stroke-dasharray="1158.116 1608.495"
          transform="rotate(-90 512 512)"
        />
      </svg>
    )
  }
</span>

<style>
  .app-icon {
    display: inline-block;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 22.5%;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.18) inset,
      0 18px 40px -12px rgb(0 0 0 / 0.7);
  }

  .app-icon.dbf {
    --icon-glow: rgb(142 153 232 / 0.55);
  }

  .app-icon.meal-planner {
    --icon-glow: rgb(130 198 159 / 0.5);
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  svg.dbf {
    background: linear-gradient(180deg, #fbfbfd, #e6e6ec);
  }

  .meal {
    background: linear-gradient(180deg, #3a7d5d, #24573f);
  }
</style>
