---
/*
 * The page grid. A mono label in the left column, content on the right,
 * a hairline above. On narrow screens the label sits above the content.
 */
interface Props {
	id?: string;
	label: string;
	number?: string;
	class?: string;
}

const { id, label, number, class: className = "" } = Astro.props;
---

<section id={id} class:list={["border-line-soft reveal border-t py-14 sm:py-20", className]}>
  <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-3">
      <h2 class="eyebrow lg:sticky lg:top-8 flex items-baseline gap-3">
        {number && <span class="text-ink-faint" aria-hidden="true">{number}</span>}
        <span>{label}</span>
      </h2>
    </div>
    <div class="lg:col-span-9">
      <slot />
    </div>
  </div>
</section>
