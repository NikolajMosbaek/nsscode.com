---
/*
 * The interim home page: four directions for the lab's front page, built
 * as live demos. Replaces the personal page, which the owner decided
 * against; its sections remain under components/sections for reference.
 */
import { demos } from "../data/demos";
---

<section class="pt-14 pb-12 sm:pt-24 sm:pb-16">
  <p class="eyebrow mb-6">Work in progress</p>
  <h1 class="text-display max-w-[16ch] font-medium text-balance">Four home pages. One will win.</h1>
  <p class="prose-site mt-8">
    nsscode.com is becoming a lab of small tools and toys that run in the browser. The front page is not decided yet, so here are four candidates as working pages, with the real experiments and the planned ones marked soon. The button in the corner of each says what it is for and what it costs.
  </p>
</section>

<section class="border-line-soft border-t py-12 sm:py-16" aria-label="Directions">
  <ul class="divide-line-soft divide-y">
    {
      demos.map((demo) => (
        <li>
          <a href={`/demo/${demo.slug}/`} class="group grid gap-x-8 gap-y-1 py-6 sm:grid-cols-[9rem_1fr]">
            <span class="eyebrow pt-1.5">{demo.letter}</span>
            <span>
              <span class="text-h3 group-hover:text-accent font-medium transition-colors">{demo.name}</span>
              <span class="text-small text-ink-muted mt-1.5 block max-w-[60ch]">{demo.tagline}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="eyebrow mt-10">
    <a href="/lab/" class="hover:text-ink transition-colors">Or skip to the lab &rarr;</a>
  </p>
</section>
