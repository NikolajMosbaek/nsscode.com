---
/*
 * The only JavaScript the site ships on purpose. The no-flash script that
 * applies the stored theme before first paint lives in BaseLayout's head.
 */
---

<button type="button" data-theme-toggle class="theme-toggle pill min-w-11 justify-center px-0" aria-label="Switch to dark theme">
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
  </svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    width: 44px;
    cursor: pointer;
    background: transparent;
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .icon-sun {
    display: block;
  }
  :root[data-theme="dark"] .theme-toggle .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle .icon-sun {
      display: block;
    }
    :root:not([data-theme="light"]) .theme-toggle .icon-moon {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

  function effectiveTheme(): "light" | "dark" {
    const set = root.dataset.theme;
    if (set === "light" || set === "dark") return set;
    return prefersDark.matches ? "dark" : "light";
  }

  function label(button: HTMLButtonElement) {
    const next = effectiveTheme() === "dark" ? "light" : "dark";
    button.setAttribute("aria-label", `Switch to ${next} theme`);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    label(button);
    button.addEventListener("click", () => {
      const next = effectiveTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* storage unavailable; the choice lasts for this page only */
      }
      label(button);
    });
    prefersDark.addEventListener("change", () => label(button));
  }
</script>
