---
import { site } from "../data/site";

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	type?: "website" | "article";
}

const {
	title,
	description = site.description,
	noindex = false,
	type = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL("/og.png", site.url).href;

const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	jobTitle: site.title,
	url: site.url,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Copenhagen",
		addressCountry: "DK",
	},
	sameAs: site.links.map((link) => link.href),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content="nsscode.com" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_DK" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:creator" content="@NikolajMosb" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
