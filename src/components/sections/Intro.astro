---
import { site } from "../../data/site";
import { timeline } from "../../data/timeline";

const now = timeline.find((entry) => entry.current);
---

<section class="pt-14 pb-16 sm:pt-24 sm:pb-24" aria-labelledby="intro-heading">
  <p class="eyebrow mb-8 flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="text-ink">{site.name}</span>
    <span aria-hidden="true">/</span>
    <span>{site.title}</span>
    <span aria-hidden="true">/</span>
    <span>{site.location}</span>
  </p>

  <h1 id="intro-heading" class="text-display max-w-[18ch] font-medium text-balance">
    Eleven years of iOS. Strict about concurrency, one architecture per app, and tests that use the seams the code uses.
  </h1>

  <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:gap-x-10">
    <p class="text-lede text-ink-soft lg:col-span-7 max-w-[38ch] text-pretty">
      I build iOS and iPadOS apps in Swift 6 with The Composable Architecture, and I care more about what a codebase looks like in year three than in week one.
    </p>

    <dl class="lg:col-span-4 lg:col-start-9 grid gap-5 self-end">
      {
        now && (
          <div class="border-line-soft border-t pt-4">
            <dt class="eyebrow mb-1.5 flex items-center gap-2">
              <span class="bg-accent inline-block size-1.5 rounded-full" aria-hidden="true"></span>
              Now
            </dt>
            <dd class="text-small text-ink-soft">
              {now.role}, {now.org}
            </dd>
          </div>
        )
      }
      <div class="border-line-soft border-t pt-4">
        <dt class="eyebrow mb-1.5">Elsewhere</dt>
        <dd class="text-small flex flex-wrap gap-x-4 gap-y-1">
          {
            site.links.map((link) => (
              <a href={link.href} rel="me noopener" class="link hover:link-hover">
                {link.label}
              </a>
            ))
          }
        </dd>
      </div>
    </dl>
  </div>
</section>
