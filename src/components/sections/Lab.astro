---
import { buildRegistry, type ExperimentMeta, listed } from "../../lib/registry";
import Section from "../Section.astro";

const modules = import.meta.glob<{ default: ExperimentMeta }>(
	"../../experiments/*/meta.ts",
	{ eager: true },
);
const experiments = listed(buildRegistry(modules));
---

<Section id="lab" label="Lab" number="05">
  <p class="prose-site mb-8">
    Experiments. Small things built to learn something, kept here so they have a URL. Some are listed, some are not.
  </p>
  <ul class="divide-line-soft divide-y">
    {
      experiments.map((experiment) => (
        <li>
          <a href={experiment.href} class="group grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[9rem_1fr]">
            <span class="eyebrow pt-1">{experiment.date}</span>
            <span>
              <span class="text-body group-hover:text-accent font-medium transition-colors">{experiment.title}</span>
              <span class="text-small text-ink-muted mt-1 block">{experiment.summary}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {experiments.length === 0 && <p class="text-small text-ink-muted">Nothing listed yet.</p>}
  <p class="eyebrow mt-8">
    <a href="/lab/" class="hover:text-ink transition-colors">All experiments &rarr;</a>
  </p>
</Section>
